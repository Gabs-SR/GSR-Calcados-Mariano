NODE_ENV=development
PORT=3000

# URL do PostgreSQL criado no Render.
# Nunca coloque a URL real neste arquivo ou no Git.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Em desenvolvimento local, normalmente false.
# No Render, o PostgreSQL usa TLS; o db.js ativa SSL automaticamente em produção.
DB_SSL=false

# Configurações opcionais do pool PostgreSQL
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

FRONTEND_URL=http://localhost:5173
ADMIN_SENHA_HASH=
SESSAO_SEGREDO=
